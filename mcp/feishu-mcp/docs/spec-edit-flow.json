{
  "title": "文档原地编辑流程",
  "subtitle": "解析 → 读块树 → 定位 block_id → 选工具改 → 限频保护",
  "width": 1180,
  "height": 900,
  "cards": [
    {
      "title": "① 解析文档",
      "sub": "feishu_resolve_doc",
      "theme": "green",
      "x": 40,
      "y": 140,
      "w": 320,
      "h": 190,
      "items": [
        "wiki 链接 / wiki token",
        "docx 文档 ID",
        "→ 统一文档 ID"
      ]
    },
    {
      "title": "② 读块树",
      "sub": "feishu_read_document",
      "theme": "green",
      "x": 430,
      "y": 140,
      "w": 320,
      "h": 190,
      "items": [
        "标题 + 完整块树",
        "block_id / 类型 / 下标",
        "include_style 可选样式"
      ]
    },
    {
      "title": "③ 定位目标块",
      "sub": "blocks[].block_id",
      "theme": "blue",
      "x": 820,
      "y": 140,
      "w": 320,
      "h": 190,
      "items": [
        "children 缺失也不压缩下标",
        "index 可直接喂给插入工具",
        "title_block_id 即文档标题"
      ]
    },
    {
      "title": "④ 原地修改",
      "sub": "update_block / patch_block",
      "theme": "purple",
      "x": 820,
      "y": 430,
      "w": 320,
      "h": 200,
      "items": [
        "整段覆盖：ID 与位置不变",
        "段内替换：保住其余格式",
        "spans：加粗 / 链接 / 行内代码"
      ]
    },
    {
      "title": "⑤ 增删换块",
      "sub": "insert / delete / replace",
      "theme": "blue",
      "x": 430,
      "y": 430,
      "w": 320,
      "h": 200,
      "items": [
        "index 任意位置插入",
        "children 嵌套列表 / 高亮块",
        "replace = 插新删旧（ID 会变）"
      ]
    },
    {
      "title": "⑥ 批量与预检",
      "sub": "feishu_edit_document",
      "theme": "orange",
      "x": 40,
      "y": 430,
      "w": 320,
      "h": 200,
      "items": [
        "多步 operations 一次提交",
        "dry_run=true 先预演",
        "整篇结构调整走这条"
      ]
    }
  ],
